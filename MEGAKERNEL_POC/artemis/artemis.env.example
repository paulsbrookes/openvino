# Optional overrides for MEGAKERNEL_POC/artemis/*.sh.
# Copy this file outside the repository and set ARTEMIS_ENV_FILE to its path.

# Persistent, runner-owned directory. Do not put this inside an Artemis checkout.
export ARTEMIS_CACHE_ROOT="$HOME/.cache/artemis/openvino-megakernel"

# Tune for the runner.
export ARTEMIS_BUILD_JOBS=12
export ARTEMIS_DEVICE=CPU

# Benchmark settings.
export ARTEMIS_TOKENS=300
export ARTEMIS_GEN_WARMUP=1
export ARTEMIS_GEN_ITERS=3

# Panther Lake example after confirming the device name with:
#   $ARTEMIS_CACHE_ROOT/install/setupvars.sh
#   $ARTEMIS_CACHE_ROOT/venv/bin/python -c \
#     'import openvino as ov; print(ov.Core().available_devices)'
# export ARTEMIS_DEVICE=GPU
